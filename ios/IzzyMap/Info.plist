<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated keys (GENERATE_INFOPLIST_FILE; the INFOPLIST_KEY_
	     settings in project.yml). Apple-Hosted Background Assets
	     ("Downloading Apple-hosted asset packs"): exactly these three keys,
	     and no other BA* keys. -->
	<key>BAAppGroupID</key>
	<string>group.org.gruenschloss.izzymap</string>
	<key>BAHasManagedAssetPacks</key>
	<true/>
	<key>BAUsesAppleHosting</key>
	<true/>
	<!-- Detailed-area downloads: user-started BGContinuedProcessingTask
	     requests (iOS 26), wildcard form — each run submits
	     org.gruenschloss.izzymap.areas.<n> (Areas/AreaBackgroundTask.swift);
	     pack queues ("Get all", 1 GB+ packs) submit
	     org.gruenschloss.izzymap.packs.<n> (Data/PackStore.swift). -->
	<!-- Pins export to Google Docs (docs/PINS_PLAN.md §6): the iOS OAuth
	     client id from the gitignored Config/Google.xcconfig (empty without
	     it: then the app offers only "Share file"). No CFBundleURLTypes:
	     ASWebAuthenticationSession catches the reversed-client-id redirect
	     itself (its callback scheme). -->
	<key>GoogleOAuthClientID</key>
	<string>$(GOOGLE_OAUTH_CLIENT_ID)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.gruenschloss.izzymap.areas.*</string>
		<string>org.gruenschloss.izzymap.packs.*</string>
	</array>
	<!-- Pins sync: CloudKit's silent pushes wake the app so SwiftData's
	     mirroring imports another device's changes (no INFOPLIST_KEY_ form) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
