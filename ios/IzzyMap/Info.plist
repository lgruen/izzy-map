<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated keys (GENERATE_INFOPLIST_FILE; the INFOPLIST_KEY_
	     settings in project.yml). Apple-Hosted Background Assets
	     ("Downloading Apple-hosted asset packs"): exactly these three keys,
	     and no other BA* keys. -->
	<key>BAAppGroupID</key>
	<string>group.org.gruenschloss.izzymap</string>
	<key>BAHasManagedAssetPacks</key>
	<true/>
	<key>BAUsesAppleHosting</key>
	<true/>
	<!-- Detailed-area downloads: user-started BGContinuedProcessingTask
	     requests (iOS 26), wildcard form — each run submits
	     org.gruenschloss.izzymap.areas.<n> (Areas/AreaBackgroundTask.swift);
	     pack queues ("Get all", 1 GB+ packs) submit
	     org.gruenschloss.izzymap.packs.<n> (Data/PackStore.swift). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.gruenschloss.izzymap.areas.*</string>
		<string>org.gruenschloss.izzymap.packs.*</string>
	</array>
</dict>
</plist>
