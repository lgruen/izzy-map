<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- simulator builds: the App Group only (the ad-hoc simulator signature
	     can't carry increased-memory-limit) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.gruenschloss.izzymap</string>
	</array>
</dict>
</plist>
