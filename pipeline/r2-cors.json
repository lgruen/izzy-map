{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://lgruen.github.io",
          "http://localhost:5199",
          "http://localhost:5200",
          "http://localhost:4173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "if-match"]
      },
      "exposeHeaders": ["content-length", "content-range", "etag"],
      "maxAgeSeconds": 86400
    }
  ]
}
